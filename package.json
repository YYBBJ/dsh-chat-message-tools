{
  "name": "dsh-chat-message-tools",
  "version": "0.1.1",
  "description": "Delete a message (and everything after it), edit and resend, or permanently delete a whole conversation from the DSH chat page.",
  "type": "module",
  "main": "host.mjs",
  "exports": {
    ".": "./host.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "conversation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node tests/host.mjs && node tests/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
